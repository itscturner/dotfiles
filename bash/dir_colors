# --- Terminal Compatibility ---
# Use wildcards so modern terminals (xterm-256color, tmux-256color, alacritty)
# match properly instead of falling back to monochrome.
TERM Eterm
TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mach-color
TERM mach-gnu-color
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM st-*
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*

# --- ANSI Color Code Reference ---
# Attributes: 00=none, 01=bold, 04=underscore, 05=blink, 07=reverse, 08=concealed
# Text color: 30=black, 31=red, 32=green, 33=yellow, 34=blue, 35=magenta, 36=cyan, 37=white
# Background: 40=black, 41=red, 42=green, 43=yellow, 44=blue, 45=magenta, 46=cyan, 47=white

# --- Core File System Types ---
NORMAL 00                     # Normal
FILE 00                       # Regular file
DIR 01;34                     # Directory
LINK 01;33                    # Symbolic link
EXEC 01;31                    # File with execute permission
ORPHAN 40;31;01               # Symlink to nonexistent file
SOCK 01;35                    # Socket
DOOR 01;35                    # Door
FIFO 40;33                    # Pipe
BLK 30;33;01                  # Block device driver
CHR 40;33;01                  # Character device driver
SETUID 95;43;01               # File that is setuid (u+s)
SETGID 30;43;01               # File that is setgid (g+s)
STICKY 00;44                  # Dir with the sticky bit set (+t) and not other-writable
OTHER_WRITABLE 00;42          # Dir that is other-writable (o+w)
STICKY_OTHER_WRITABLE 00;42   # Dir that is sticky and other-writable (+t,o+w)
MISSING 01;05;00;41           # Nonexistent file they point to
CAPABILITY 30;41              # File with capability

